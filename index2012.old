<SCRIPT LANGUAGE="JavaScript">
	
  function affiche(num) {	
    numdev=new Array;
    enonce=new Array;
    dateremise=new Array;


  //Énoncés des devoirs

  numdev[1]='1';
  enonce[1]='Lab 1 nos 1d), 2c), 8 </br> Lab 2 nos 1 et 3b)';
  dateremise[1]='le lundi 25 mai 2009 à 15 h 30.';


  numdev[2]='2';
  enonce[2]='Lab  no ';
  dateremise[2]='le lundi  2009 à 15 h 30.';


  numdev[3]='3';
  enonce[3]='Lab  no ';
  dateremise[3]='le lundi  2009 à 15 h 30.';

  numdev[4]='4';
  enonce[4]='Lab  no ';
  dateremise[4]='le lundi  2009 à 15 h 30.';

  numdev[5]='5';
  enonce[5]='Lab  no ';
  dateremise[5]='le lundi  2009 à 15 h 30.';

  numdev[6]='6';
  enonce[6]='Lab  no ';
  dateremise[6]='le lundi  2009 à 15 h 30.';

  numdev[7]='7';
  enonce[7]='Lab  no ';
  dateremise[7]='le mardi  2009</i>';

  numdev[8]='8';
  enonce[8]='Lab  no ';
  dateremise[8]='le mardi  2009</i>';

  numdev[9]='9';
  enonce[9]='Lab  no ';
  dateremise[9]='le mardi  2009</i>';

  numdev[10]='10';
  enonce[10]='Lab  no ';
  dateremise[10]='le mardi  2009</i>';


// MAT297

  numdev[20]='1';
  enonce[20]='Chapitre 1 no 6 <br> Chapitre 2 no 10b) <br> Chapitre 3 no 4b) <br> Chapitre 4 no 2 <br> Chapitre 5 no 5.2c)';
  dateremise[20]='le vendredi 27 février 2009</i>';


  numdev[21]='2';
  enonce[21]='Chapitre  nos';
  dateremise[21]='le vendredi 2009</i>';


  numdev[22]='3';
  enonce[22]='Section 6.6.2 no 3i (montrer que la limite est -delta\') <br>'+
              'Section 6.9.3 no 1d <br>'+
              'Section 7.9 no 1 <br>'+
              'Section 9.4 no A iv (distinguer les cas alpha=beta et alpha != beta) <br>'+
              'Section 9.5.2 i';
  dateremise[22]='le vendredi 17 avril 2009</i>';

  numdev[23]='4';
  enonce[23]='Chapitre  nos ';
  dateremise[23]='le vendredi  2009</i>';

  numdev[24]='5';
  enonce[24]='Chapitre  nos ';
  dateremise[24]='le vendredi  2009</i>';

  ferme='<center><A HREF="javascript:window.close()"><font size=-1>Fermer la fenêtre</font></A></center>';
	
  //Creer la fenetre
	
  options = "toolbar=0,status=0,menubar=0,scrollbars=1,resizable=1,width=500,height=300";
  newwindow=window.open("","mywindow", options);
  newwindow.document.write('<body bgcolor="beige"><h2><p align="center">Devoir '+numdev[num]+'</p></h2>');
  newwindow.document.write('<body bgcolor="beige"><h3>Énoncé : </h3>'+enonce[num]+'.<br><br>');
  newwindow.document.write('<body bgcolor="beige"><b>Date de remise : </b> au plus tard '+dateremise[num]+'<!-- par <i>turnin</i>-->.<br><br><br>');
  newwindow.document.write(ferme);        
  newwindow.document.close();
	
  }

</SCRIPT>
