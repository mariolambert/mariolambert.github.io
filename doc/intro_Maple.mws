" 0 "" {MPLTEXT 1 0 25 "   for j from k+1 to n do" }}{PARA 0 "> " 0 "
" {MPLTEXT 1 0 75 "     temp:=evalf[m]( temp+evalf[m]( evalf[m](A[k,j]
) * evalf[m](b[j,1]) ) )" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 6 "   od;" 
}}{PARA 0 "> " 0 "" {MPLTEXT 1 0 47 "   b[k,1]:=evalf[m]( evalf[m](b[k
,1]) - temp );" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 48 "   b[k,1]:=evalf[
