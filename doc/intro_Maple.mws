\351es. " }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 
20 "Par exemple, si x<>0" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 29 "angle:=
