{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 7 "Alors, " }
}{PARA 0 "> " 0 "" {MPLTEXT 1 0 16 "f_rond_g := f@g;" }}{PARA 0 "" 0 "
" {TEXT -1 45 "est la composition des deux fonctions et on a" }}{PARA 
0 "> " 0 "" {MPLTEXT 1 0 12 "f_rond_g(1);" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 12 "f_rond_g(2);" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 12 "f_
rond_g(3);" }{TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "
" 0 "" {TEXT -1 100 "Enfin, l'op\351rateur \"@@\" nous permet de compo
ser une fonction avec elle-m\352me \"n\" fois. On a donc que " }}
{PARA 0 "" 0 "" {TEXT -1 60 "(f@@n)(x) est la m\352me chose que f(f(f(
...(f(x)))))  (n fois)" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "(D@@2)(ln
);" }{TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "> " 0 "
