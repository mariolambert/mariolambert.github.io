" 0 "" {TEXT -1 12 "      local " }{TEXT 271 5 "i,j,k" }{TEXT -1 23 ";
   # variables locales" }}{PARA 0 "" 0 "" {TEXT -1 13 "      global " 
}{TEXT 272 5 "A,B,C" }{TEXT -1 55 ";  # variables globales (accessible
s apr\350s l'ex\351cution)" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 
"" 0 "" {TEXT -1 4 "...." }}{PARA 0 "" 0 "" {TEXT -1 4 "end;" }}{PARA 
0 "" 0 "" {TEXT -1 0 "" }}}{SECT 1 {PARA 5 "" 0 "" {TEXT -1 9 "D\351bo
ggage" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 21 "
On peut utiliser soit" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 15 "printlevel
:= n;" }{TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 111 "o\371 n est un e
ntier positif (par d\351faut 1). Plus n est grand, plus le niveau d'in
formations affich\351es est grand." }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}
{PARA 0 "" 0 "" {TEXT -1 9 "ou encore" }}{PARA 0 "> " 0 "" {MPLTEXT 1 
0 21 "trace(nom_programme);" }}{PARA 0 "" 0 "" {TEXT -1 107 "Cela perm
et d'afficher le d\351roulement de la proc\351dure pas \340 pas (est i
nfluenc\351 par le niveau de printlevel)" }}{PARA 0 "" 0 "" {TEXT -1 
0 "" }{MPLTEXT 1 0 0 "" }}}{SECT 1 {PARA 5 "" 0 "" {TEXT -1 7 "Exemple
" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 56 "Rappe
l: Soit f: A-->B une application. On dit que f est " }{TEXT 275 9 "inj
ective" }{TEXT -1 58 " si pour tous a et a' dans A, f(a)=f(a') entra
\356ne que a=a'" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" 
{TEXT -1 182 "Probl\350me: Soit U=\{a1,a2,...,an\} un univers fixe \+
\340 n \351l\351ments (n est fini). Soit f: U-->U une application de U
 \340 valeurs dans U. Comment faire pour v\351rifier si f est injectiv
e ou non?" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 
40 "Solution: On peut construire les listes " }}{PARA 0 "" 0 "" {TEXT 
-1 18 "U:=[a1,a2,...,an];" }}{PARA 0 "" 0 "" {TEXT -1 31 "im_f:= [f(a1
),f(a2),...,f(an)];" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{EXCHG {PARA 0 
"> " 0 "" {MPLTEXT 1 0 23 "injective:=proc(U,im_f)" }}{PARA 0 "> " 0 "
" {MPLTEXT 1 0 18 "local nb_elts,i,j;" }}{PARA 0 "> " 0 "" {MPLTEXT 1 
0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 17 "nb_elts:=nops(f);" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 
26 "for i from 1 to nb_elts do" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 30 " \+
   for j from 1 to nb_elts do" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 32 "  \+
      if im_f[i]=im_f[j] then " }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 24 " \+
          RETURN(false)" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "        \+
fi;" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 7 "    od;" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 3 "od;" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "
> " 0 "" {MPLTEXT 1 0 5 "true;" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" 
}}{PARA 0 "> " 0 "" {MPLTEXT 1 0 4 "end;" }}{PARA 12 "" 1 "" {TEXT -1 
0 "" }}}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 19 "P
renons par exemple" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 15 "U:=[1,2,3,4,5
];" }{TEXT -1 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "f:=x->x;" }}
{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 6 "Alors," }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 48 "im_f:=[f(U[1]),f(U[2]),f(U[3]),f(U[
4]),f(U[5])];" }{TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 2 "et" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 18 "injective(U,im_f);" }{TEXT -1 0 "" 
}}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 41 "Pourtan
t, c'est une fonction injective!?!" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 14 "printlevel:=2;" }{TEXT -1 0 "" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 17 "trace(injective);" }{TEXT -1 0 "" }
}{PARA 0 "> " 0 "" {MPLTEXT 1 0 19 "injective(U, im_f);" }}{PARA 0 "> \+
" 0 "" {MPLTEXT 1 0 0 "" }}{PARA 11 "" 1 "" {TEXT -1 0 "" }}}{SECT 1 
{PARA 5 "" 0 "" {TEXT -1 48 "Exemple 2 (m\351thode de Gauss et phase a
scendante)" }}{PARA 0 "" 0 "" {TEXT -1 38 "# En entr\351e : Une matric
e A inversible" }}{PARA 0 "" 0 "" {TEXT -1 33 "#                    Un
 vecteur b" }}{PARA 0 "" 0 "" {TEXT -1 61 "# En sortie : La matrice M \+
qui contient les constantes M[i,k]" }}{PARA 0 "" 0 "" {TEXT -1 85 "#  \+
                 Les matrices A_ech et b_ech, \351chelonn\351e selon l
a m\351thode de Gauss" }}{PARA 0 "" 0 "" {TEXT -1 19 "#               \+
   " }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 23 "gauss_prec:=proc(A,b,m)" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 28 "   local i,j,k,n,temp, M, C;" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 22 "   global A_ech,b_ech;" }}{PARA 0 "> " 0 "" {MPLTEXT 
1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 40 "# On d\351termine la tai
lle de la matrice A" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 21 "n:=linalg[ro
wdim](A);" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> \+
" 0 "" {MPLTEXT 1 0 28 "# d\351finition de la matrice M" }}{PARA 0 "> \+
" 0 "" {MPLTEXT 1 0 17 "M:=matrix(n,n,0);" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 20 "for i from 1 to n do" }}{PARA 0 "> " 0 "" {MPLTEXT 1 
0 11 "  M[i,i]:=1" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 3 "od;" }}{PARA 0 
"> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 
46 "# On construit la matrice augment\351e du syst\350me" }}{PARA 0 ">
 " 0 "" {MPLTEXT 1 0 24 "C:=linalg[augment](A,b);" }}{PARA 0 "> " 0 "
" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 ">
 " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 32 "# D\351
but de l'algorithme de Gauss" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 22 "for
 k from 1 to n-1 do" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "
> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 58 "  # On intervertit les lignes pour \+
avoir un pivot non nul." }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 20 "  if C[k
,k] = 0 then" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 14 "    temp:=k+1;" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 26 "    while C[temp,k] = 0 do" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 24 "      temp:=temp+1;     " }}{PARA 
0 "> " 0 "" {MPLTEXT 1 0 7 "    od;" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 
32 "    C:=linalg[swaprow](C,k,temp)" }}{PARA 0 "> " 0 "" {MPLTEXT 1 
0 5 "  fi;" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> \+
" 0 "" {MPLTEXT 1 0 57 "  # On convertit la matrice C \340 m chiffres \+
significatifs " }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 22 "  for i from 1 to
 n do" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 26 "    for j from 1 to n+1 do
" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 30 "      C[i,j]:=evalf[m](C[i,j])
" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 6 "    od" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 5 "  od;" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 
0 "> " 0 "" {MPLTEXT 1 0 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 25 "  # On calcule les M[i,k]" }}{PARA 
