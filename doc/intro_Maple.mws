1 1 2 1.000000 38.000000 63.000000 0 0 "Curve 1" }}}{SECT 1 {PARA 3 "
" 0 "" {TEXT -1 12 "Introduction" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}
{PARA 0 "" 0 "" {URLLINK 17 "MapleVI" 4 "http://www.maplesoft.com" "" 
}{TEXT -1 488 " est un environnement math\351matique permettant de sol
utionner une vari\351t\351 de probl\350mes allant des op\351rations ma
th\351matiques de base jusqu'\340 l'analyse num\351rique, l'alg\350bre
 symbolique et m\352me la th\351orie de la relativit\351. Maple nous o
ffre des sessions interactives, une interface graphique avec de vraies
 entr\351es math\351matiques, des possibilit\351s de mise en page (LaT
eX) et un langage de programmation complet, ce qui en fait un logiciel
 de choix dans la formation, la recherche et l'industrie. " }}{PARA 0 
"" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 75 "Parmi les autres \+
logiciels tr\350s utilis\351s en calcul symbolique, on retrouve " }
{URLLINK 17 "Mathematica" 4 "http://www.wri.com/products/mathematica" 
"" }{TEXT -1 4 " et " }{URLLINK 17 "Mathcad" 4 "http://www.mathcad.com
" "" }{TEXT -1 3 " . " }{MPLTEXT 1 0 1 " " }}{PARA 0 "" 0 "" {TEXT -1 
0 "" }}{PARA 0 "" 0 "" {TEXT -1 111 "La premi\350re version commercial
e de Maple (3.3) a \351t\351 distribu\351e en 1985 par l'Universit\351
 de Waterloo (Ontario)." }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 
0 "" {TEXT -1 0 "" }}}{SECT 1 {PARA 3 "" 0 "" {TEXT -1 17 "Commandes d
e base" }}{SECT 1 {PARA 4 "" 0 "" {TEXT -1 12 "Affectations" }}{PARA 
0 "" 0 "" {TEXT -1 143 " L'op\351rateur d'affectation en Maple est le \+
:= et chaque ligne de commande doit se terminer par un point-virgule (
;) ou par les deux points (:)." }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 15 "nom:= Lambert; " }{TEXT -1 74 "# af
fecte \340 la variable nom la valeur 'Lambert' et en provoque l'\351cr
iture." }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 16 "prenom:= Mario: " }{TEXT 
-1 74 "# affecte \340 la variable pr\351nom la valeur 'Mario' sans en \+
faire l'\351criture." }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 8 "prenom; " }
{TEXT -1 76 "# v\351rifie que Mario est bel et bien la valeur affect
\351e \340 la variable pr\351nom." }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 0 
"" }}}{SECT 1 {PARA 4 "" 0 "" {TEXT -1 37 "Op\351rations math\351matiq
ues \351l\351mentaires" }}{PARA 0 "" 0 "" {TEXT -1 20 "+, *, -, /, ^ o
u **." }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 4 "2+3;" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 4 "2^3;" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 5 "2**3;" }
{TEXT -1 1 " " }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" 
{TEXT -1 222 "Comme Maple effectue ses calculs symboliquement, il n'
\351value pas les expressions \340 chaque \351tape du calcul afin d'
\351viter les erreurs d'arrondis. Ainsi, si on veut la valeur num\351r
ique d'un r\351sultat, il faut le lui sp\351cifier." }}{PARA 0 "> " 0 
"" {MPLTEXT 1 0 7 "26/65; " }{TEXT -1 36 "# affiche le r\351sultat sym
boliquement" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 13 "evalf[n](%); " }
{TEXT -1 124 "# convertit le r\351sultat en virgule flottante \340 n c
hiffres avec arrondi au plus pr\350s (5 s'arrondit vers le pair le plu
s pr\350s)" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT 
