1 0 16 "with(numtheory);" }{TEXT -1 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 
1 0 0 "" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{SECT 1 {PARA 5 "" 0 "" 
{TEXT -1 22 "Principales commandes " }}{PARA 0 "" 0 "" {TEXT -1 0 "" }
}{PARA 0 "> " 0 "" {MPLTEXT 1 0 17 "nextprime(1234); " }{TEXT -1 53 "#
 donne le nombre premier qui suit imm\351diatement 1234" }}{PARA 0 "> \+
" 0 "" {MPLTEXT 1 0 17 "prevprime(1234); " }{TEXT -1 56 "# donne le no
mbre premier qui pr\351c\350de imm\351diatement 1234" }}{PARA 0 "> " 
0 "" {MPLTEXT 1 0 15 "isprime(1234); " }{TEXT -1 29 "# v\351rifie si 1
234 est premier" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 15 "ifactor(1234); \+
" }{TEXT -1 50 "# factorise 1234 en un produit de nombres premiers" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 11 "phi(1234); " }{TEXT -1 112 "# donne
 la constante d'Euler de 1234 (\340 n'utiliser que si on ne conna\356t
 pas de fa\347on plus simple de la calculer)" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 18 "power(x,e) mod m; " }{TEXT -1 145 "# calcule x^e MOD \+
m (utilise un algorithme de calcul plus performant que de d'abord calc
uler x^e, puis de calculer le reste de la division par m)" }}{PARA 0 "
> " 0 "" {MPLTEXT 1 0 0 "" }}}{SECT 1 {PARA 5 "" 0 "" {TEXT -1 7 "Exem
ple" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 105 "S
upposons que deux correspondants d'un syst\350me de correspondance \+
\340 cl\351s publiques RSA utilisent les cl\351s:" }}{PARA 0 "" 0 "" 
{TEXT -1 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 21 "px:=nextprime(10^30
);" }{TEXT -1 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 21 "qx:=nextprime(
10^23);" }{TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "> \+
" 0 "" {MPLTEXT 1 0 27 "py:=nextprime(10^30-10^25);" }{TEXT -1 0 "" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 27 "qy:=nextprime(10^27-12345);" }
{TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT 
-1 6 "Alors," }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 10 "mx:=px*qx;" }{TEXT 
-1 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 10 "my:=py*qy;" }{TEXT -1 0 "
" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 48 "Calcu
lons les constantes d'Euler correspondantes" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 25 "phi('mx'):=(px-1)*(qx-1);" }{TEXT -1 0 "" }}{PARA 0 "
> " 0 "" {MPLTEXT 1 0 25 "phi('my'):=(py-1)*(qy-1);" }{TEXT -1 0 "" }}
{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 64 "Choisisso
ns ex et ey relativement premiers \340 phi(mx) et phi(my)." }}{PARA 0 
"> " 0 "" {MPLTEXT 1 0 21 "ex:=nextprime(10^17);" }{TEXT -1 0 "" }}
{PARA 0 "> " 0 "" {MPLTEXT 1 0 21 "ey:=nextprime(10^23);" }{TEXT -1 0 
"" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 19 "igcd(ex,phi('mx'));" }{TEXT 
-1 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 19 "igcd(ey,phi('my'));" }
{TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT 
-1 28 "On trouve les cl\351s secr\350tes:" }}{PARA 0 "> " 0 "" 
{MPLTEXT 1 0 44 "dx:=op(2,op(msolve(ex * x = 1, phi('mx'))));" }{TEXT 
-1 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 44 "dy:=op(2,op(msolve(ey * y
 = 1, phi('my'))));" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "
" {TEXT -1 107 "Enfin, on d\351truit px, qx, py, qy, phi(mx), phi(my),
 on publie mx, my, ex, ey et on garde secr\350tes dx et dy." }}{PARA 
0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 146 "Supposons que \+
x veut envoyer \340 y le message \"Si l'hiver peut finir\". On pr\351-
encode d'abord ce message au moyen de la cl\351 a->01, b->02, ..., z->
26." }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 50 "message:=1909001208092205180
016052120000609140918;" }{TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 0 "
" }}{PARA 0 "" 0 "" {TEXT -1 63 "Le correspondant x signe le message a
u moyen de sa cl\351 secr\350te:" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 41 
"message_signe:=power(message, dx) mod mx;" }{TEXT -1 0 "" }}{PARA 0 "
" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 48 "Il encrypte son me
ssage pour le correspondant y:" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 48 "m
essage_envoye:=power(message_signe, ey) mod my;" }{TEXT -1 0 "" }}
{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 41 "L'ami y r
e\347oit le message et le d\351crypte:" }}{PARA 0 "> " 0 "" {MPLTEXT 
1 0 51 "message_decrypte:=power(message_envoye, dy) mod my;" }}{PARA 
0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 48 "Il s'assure que
 x est bien celui qui l'a envoy\351:" }}{PARA 0 "> " 0 "" {MPLTEXT 1 
0 54 "message_non_signe:=power(message_decrypte, ex) mod mx;" }}{PARA 
0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT -1 30 "Est-ce bien le \+
message envoy\351?" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 35 "evalb(message
_non_signe = message);" }{TEXT -1 0 "" }}{PARA 0 "> " 0 "" {MPLTEXT 1 
0 0 "" }}}}{SECT 1 {PARA 4 "" 0 "" {TEXT -1 7 "Logique" }}{PARA 0 "" 
0 "" {TEXT -1 60 "Pour cette section, il faut charger la librairie de \+
logique:" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 56 "### WARNING: `logic` is
 no longer available\nwith(logic);" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}
{PARA 0 "" 0 "" {TEXT -1 104 "On peut utiliser les op\351rateurs bool
\351ens suivants: &and, &or, &not, &iff, &nor, &nand, &xor et &implies
." }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{SECT 0 {PARA 5 "" 0 "" {TEXT -1 
